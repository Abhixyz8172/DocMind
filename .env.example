# --- LLM ---
LLM_PROVIDER=openai            # openai | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Embeddings (swap to BAAI/bge-large-en-v1.5 or thenlper/gte-large for higher accuracy) ---
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Vector store / retrieval ---
CHROMA_DIR=./chroma_db
COLLECTION=docs
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
